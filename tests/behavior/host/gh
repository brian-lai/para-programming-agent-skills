#!/usr/bin/env python3
import json
import os
import sys
import urllib.request
request = urllib.request.Request('http://gateway:8080/gh', data=json.dumps({'args': sys.argv[1:], 'cwd': os.getcwd()}).encode(), headers={'Content-Type': 'application/json'})
try:
    result = json.load(urllib.request.build_opener(urllib.request.ProxyHandler({})).open(request, timeout=60))
    print(result['output'])
    raise SystemExit(result['code'])
except (OSError, ValueError) as exc:
    print('Fixture service unavailable: ' + str(exc), file=sys.stderr)
    raise SystemExit(2)
